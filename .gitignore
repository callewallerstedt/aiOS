# Everything the user has dictated, plus the agent's running conversation and
# the facts it was told to remember. Personal by definition — never commit.
voice-transcripts.jsonl
voice-agent-memory.json
voice-agent-timers.json
phone_voice_events/

# The agent's own notes are personal; its SOUL.md (how it behaves) is not, and
# is tracked so the personality is versioned.
agent_self/*
!agent_self/SOUL.md

helper_config.json
helper_config.json.bak
phone-bridge-url.txt
phone-relay-state.json
phone_operator_events/
code_jobs/
# Benchmark runs: throwaway agent workspaces, transcripts and results. The
# tasks that produced them are in bench/suites.py, which is what matters.
bench/runs/
# Public benchmark downloads are immutable, verified caches rebuilt from the
# pins in bench/*.py; keep the source tree small.
bench/data/
# Harness-owned language servers are reproducible from these manifests; never
# commit the downloaded npm dependency tree.
.tools/lsp/node_modules/
# Saved custom prompts are local user data, not part of the harness suite.
bench/custom/
tools/cloudflared.exe
debug_runs/
agent_clicker/debug_runs/
agent_clicker/user_context/
agent_clicker/_tts_test.wav

