{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aios-remote",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aios-remote",
      "database_id": "local-aios-remote"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "aios-remote-files"
    }
  ]
}
