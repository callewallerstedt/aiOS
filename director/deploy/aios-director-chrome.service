[Unit]
Description=aiOS Director Chrome on the operator screen
After=aios-director-real-desktop.service
Wants=aios-director-real-desktop.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=GDK_BACKEND=x11
Environment=OZONE_PLATFORM=x11
# Attach the persistent Operator profile to Calle's real GNOME/Xorg desktop.
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=%h/.local/share/aios-director/chrome-profile --no-first-run --no-default-browser-check --disable-session-crashed-bubble --restore-last-session --password-store=basic --disable-dev-shm-usage --ozone-platform=x11 --force-renderer-accessibility --window-size=1280,720 --window-position=0,0 --start-maximized
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
