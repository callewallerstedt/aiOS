[Unit]
Description=aiOS Director Chrome on the operator screen
After=aios-director-wm.service
Wants=aios-director-wm.service

[Service]
Type=simple
Environment=DISPLAY=:99
Environment=XAUTHORITY=
Environment=GDK_BACKEND=x11
Environment=OZONE_PLATFORM=x11
# Force X11: this box's Chrome defaults to Wayland and dies on Xvfb.
# Restore the last session so a bounce does not wipe the tabs the operator had open.
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=%h/.local/share/aios-director/chrome-profile --no-first-run --no-default-browser-check --disable-session-crashed-bubble --restore-last-session --password-store=basic --disable-gpu --use-gl=angle --use-angle=swiftshader --disable-dev-shm-usage --no-sandbox --ozone-platform=x11 --window-size=1600,900 --window-position=0,0 --start-maximized
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
