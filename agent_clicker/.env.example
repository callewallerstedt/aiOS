# Copy to .env and fill in
OPENAI_API_KEY=

# Model used by Agent Clicker / OPERATOR
AGENT_MODEL=gpt-5.5

# SAM3 (text-prompted segmentation). Leave blank unless installed.
SAM3_PYTHON=
SAM3_SCRIPT=
SAM3_CHECKPOINT=

# Max reasoning rounds per task
AGENT_MAX_ROUNDS=8

# OCR backend: easyocr  (default)  or  none
AGENT_OCR=easyocr

# Optional OmniParser — leave blank unless installed
OMNIPARSER_PATH=
